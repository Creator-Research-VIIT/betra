generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Membership {
  id               String   @id @default(uuid())
  name             String
  email            String
  cellNumber       String
  bankName         String
  branch           String
  branchCode       String
  issueDescription String
  createdAt        DateTime @default(now())
}